# 复制为 .env 后按需修改（.env 不要提交到 Git）
# fake：本地假模型，无需 key，直接能跑
LLM_PROVIDER=fake

# 切到真实 API 时把上面改成 api，并填好下面三项
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048

# 超时（秒）：connect=建连；timeout=读取（流式下指两个数据块之间的最大间隔）
LLM_CONNECT_TIMEOUT=5
LLM_TIMEOUT=60

# 重试：指数退避 + 抖动；上游给了 Retry-After 则优先遵守（但不超过下面的上限）
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=8
LLM_RETRY_AFTER_CAP=30

# 是否把推理模型的思维链(reasoning)一并下发给前端
LLM_SHOW_REASONING=true
